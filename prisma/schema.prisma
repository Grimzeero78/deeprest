// DeepRest — Gamified Rehabilitation & Support Platform
// Prisma schema — mapped 1:1 onto the Cloudflare D1 tables in
// /cloudflare/schema.sql (snake_case). The SAME client runs on:
//   • Cloudflare Workers → @prisma/adapter-d1  (env.DB binding)
//   • Local dev          → @prisma/adapter-better-sqlite3 (file DB)
// `prisma db push` recreates the local file DB with identical
// table/column names, so local and production stay in lockstep.

// The new `prisma-client` generator emits a pure-TypeScript client
// (queryCompiler engine, zero Rust binaries) — required for Workers.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique // lowercased display name — used for login (no email)
  name         String   // display name exactly as entered
  passwordHash String   @map("password_hash")
  passwordHint String?  @map("password_hint") // optional hint shown after a failed sign-in
  avatarColor  String   @default("#8b5cf6") @map("avatar_color")
  avatarImage  String?  @map("avatar_image") // WhatsApp-style profile photo (small data URL)
  avatarEmoji  String?  @map("avatar_emoji") // optional emoji avatar (used when no photo)
  bio          String?  // WhatsApp-style "About" status line
  totalPoints  Int      @default(0) @map("total_points") // XP driving the 10-level rank system
  streak       Int      @default(0) // consecutive days meeting the target
  lastEvalDate String?  @map("last_eval_date") // last date the cron evaluated this user (YYYY-MM-DD)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  settings     UserSettings?
  screenLogs   ScreenTimeLog[]
  chatSessions ChatSession[]
  duosInitiated DuoPartnership[] @relation("DuoInitiator")
  duosJoined    DuoPartnership[] @relation("DuoPartner")
  sosAlertsSent SOSAlert[]       @relation("SosSender")
  convoMemberships ConversationMember[]
  messagesSent  DirectMessage[]  @relation("DmSender")

  @@map("users")
}

model UserSettings {
  id             String  @id @default(cuid())
  userId         String  @unique @map("user_id")
  dailyTargetMin Int     @default(360) @map("daily_target_min") // "6-Hour Target" in minutes
  timezone       String  @default("UTC")
  notifications  Boolean @default(true)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// One row per user per day — written by the monitoring service (Cron Trigger in prod)
model ScreenTimeLog {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  date         String // YYYY-MM-DD
  minutesUsed  Int     @default(0) @map("minutes_used")
  targetMin    Int     @default(360) @map("target_min")
  pointsEarned Int     @default(0) @map("points_earned")
  metTarget    Boolean @default(false) @map("met_target")
  evaluated    Boolean @default(false) // cron has scored this day
  topApps      String  @default("[]") @map("top_apps") // JSON: [{name, minutes, category}]
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("screen_time_logs")
}

// AI companion conversations — persona: SHEPHERD | GUIDE | COUNSELOR
model ChatSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  persona   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  messages  ChatMessage[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, persona])
  @@index([userId, persona])
  @@map("chat_sessions")
}

// Chat logs are AES-256-GCM encrypted at rest (lib/crypto.ts)
model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String      @map("session_id")
  role      String // user | assistant
  content   String // encrypted ciphertext (base64:iv:tag)
  createdAt DateTime    @default(now()) @map("created_at")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// The Dynamic Duo accountability partnership
model DuoPartnership {
  id          String   @id @default(cuid())
  initiatorId String   @map("initiator_id")
  partnerId   String?  @map("partner_id")
  inviteCode  String   @unique @map("invite_code")
  status      String   @default("PENDING") // PENDING | ACTIVE
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  initiator User  @relation("DuoInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  partner   User? @relation("DuoPartner", fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([initiatorId])
  @@index([partnerId])
  @@map("duo_partnerships")
}

// SOS panic alerts — delivered to the Dynamic Duo partner (SMS/Email/Push in prod)
model SOSAlert {
  id        String   @id @default(cuid())
  senderId  String   @map("sender_id")
  message   String
  channel   String   @default("push") // push | sms | email (simulated)
  status    String   @default("SENT") // SENT | ACKNOWLEDGED
  createdAt DateTime @default(now()) @map("created_at")
  sender    User     @relation("SosSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@map("sos_alerts")
}

// Simulated WebRTC / Cloudflare Calls signaling state machine
model CallSession {
  id         String    @id @default(cuid())
  callerId   String    @map("caller_id")
  calleeId   String    @map("callee_id")
  modality   String    @default("voice") // voice | video
  status     String    @default("RINGING") // RINGING | ACTIVE | ENDED | DECLINED | MISSED
  startedAt  DateTime  @default(now()) @map("started_at")
  answeredAt DateTime? @map("answered_at")
  endedAt    DateTime? @map("ended_at")

  @@index([callerId])
  @@index([calleeId, status])
  @@map("call_sessions")
}

// ============================================================
// Community — WhatsApp-style DMs & group chats
// ============================================================

// A conversation is a 1:1 DM (kind="dm") or a group (kind="group").
model Conversation {
  id        String   @id @default(cuid())
  kind      String   @default("dm") // dm | group
  name      String?  // group name (null for DMs)
  emoji     String?  // group avatar emoji
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  ConversationMember[]
  messages DirectMessage[]

  @@index([updatedAt])
  @@map("conversations")
}

model ConversationMember {
  id             String      @id @default(cuid())
  conversationId String      @map("conversation_id")
  userId         String      @map("user_id")
  lastReadAt     DateTime?   @map("last_read_at") // unread tracking
  joinedAt       DateTime    @default(now()) @map("joined_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model DirectMessage {
  id             String      @id @default(cuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  body           String
  kind           String      @default("text") // text | system
  createdAt      DateTime    @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User        @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}
